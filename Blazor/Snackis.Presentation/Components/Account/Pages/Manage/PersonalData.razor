@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using Snackis.Domain.Entities

@inject UserManager<SnackisUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Personal Data</PageTitle>

<StatusMessage />
<h3>Personlig data</h3>

<div class="row">
    <div class="col-md-6">
        <p>Ditt konto innehåller personuppgifter som du har lämnat till oss. På den här sidan kan du ladda ner eller radera dessa uppgifter.</p>
        <p>
            <strong>Om du raderar dessa uppgifter kommer ditt konto att tas bort permanent, och detta kan inte ångras.</strong>
        </p>
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <button class="btn btn-primary" type="submit">Ladda ner</button>
        </form>
        <p>
            <a href="Account/Manage/DeletePersonalData" class="btn btn-danger">Radera</a>
        </p>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
