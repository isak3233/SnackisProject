@page "/subsubject/{id:int}/create-post"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using Snackis.Domain.DTO
@using Snackis.Application.BlazorInterfaces
@using System.Security.Claims
@inject IPostService postService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<a class="d-block w-100 px-3 py-2 text-decoration-none" href="/subsubject/@id">
    ← Gå tillbaka
</a>
<h3>Skapa ny post</h3>

<EditForm Model="createPostDto" OnValidSubmit="CreatePostAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Rubrik</label>
        <InputText class="form-control" @bind-Value="createPostDto.Header" />
        <ValidationMessage For="@(() => createPostDto.Header)" />
    </div>

    <div class="mb-3">
        <label class="form-label">Innehåll</label>
        <InputTextArea class="form-control"
                       rows="6"
                       @bind-Value="createPostDto.TextContent" />
        <ValidationMessage For="@(() => createPostDto.TextContent)" />
    </div>

    <button type="submit" class="btn btn-primary">
        Skapa post
    </button>
    @if (showSuccess)
    {
        <div class="alert alert-success mt-3">
            Posten skapades!
        </div>
    }
    @if (errorMessage != null)
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

</EditForm>
<AuthorizeView>
        <Authorized>
            <ChatComponent />
        </Authorized>
    </AuthorizeView>
@code {
    [Parameter]
    public int id { get; set; }

    private CreatePostDto createPostDto = new CreatePostDto();
    private string? userId;
    private bool showSuccess;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
    }

    private async Task CreatePostAsync()
    {
        createPostDto.SubSubjectId = id;
        try
        {
            await postService.CreatePostAsync(createPostDto, userId);
            showSuccess = true;
            errorMessage = null;
            createPostDto = new CreatePostDto();
            StateHasChanged();
            await Task.Delay(2000);
            NavigationManager.NavigateTo($"/subsubject/{id}");
        } catch (Exception e)
        {
            showSuccess = false;
            errorMessage = e.Message;
        }



        await Task.CompletedTask;
    }

}