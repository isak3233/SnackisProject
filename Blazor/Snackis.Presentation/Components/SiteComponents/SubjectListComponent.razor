@using Snackis.Domain.DTO

<div>
    @if (Subjects == null)
    {
        <p>Laddar...</p>
    }
    else
    {
        @foreach (var subject in Subjects)
        {
            <details class="subject-card">
                <summary class="fs-3">
                    @subject.Name
                </summary>

                @if (subject.SubSubjects?.Any() == true)
                {
                    <ul class ="list-group">
                        @foreach (var sub in subject.SubSubjects)
                        {
                            <li class="list-group-item p-0">
                                <a class="d-block w-100 px-3 py-2 text-decoration-none"
                                   href="/subsubject/@sub.Id">
                                    @sub.Name
                                </a>
                            </li>
                        }
                    </ul>
                }
            </details>
        }
    }
</div>
@code {
    [Parameter]
    public List<SubjectDto>? Subjects { get; set; }

}