@using Snackis.Domain.DTO


    <div class="mt-3">

        @foreach (var comment in Comments)
        {
            <div class="d-flex gap-2 border-bottom py-3">

            <AvatarComponent AvatarUrl="@comment.AvatarUrl" />

                <div class="flex-grow-1">

                    <div class="d-flex justify-content-between align-items-center">

                        <div class="fw-bold">
                            @comment.DisplayName
                        </div>

                        <small class="text-muted">
                            @comment.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                        </small>

                    </div>

                    <div class="mt-1">
                    @if(comment.IsDeleted == true)
                    {
                        <p class="text-danger p-0 m-0">@comment.TextContent</p>
                    } else
                    {
                        <p class="p-0 m-0">@comment.TextContent</p>
                    }

                    </div>
                <div class="d-flex justify-content-end">
                    @if(comment.IsDeleted == false)
                    {
                        <CreateReportComponent postCommentId="comment.Id" />
                    }
                    
                </div>

                </div>

            </div>
        }

    </div>


@code {
    [Parameter]
    [EditorRequired]
    public List<PostCommentDto> Comments { get; set; }
}