@using Microsoft.AspNetCore.Components.Authorization
@using Snackis.Application.BlazorInterfaces
@inject AuthenticationStateProvider AuthStateProvider
@inject IPostService postService

<AuthorizeView>
    <Authorized>
        <div class="mb-3">

            <div class="d-flex justify-content-end mt-2">
                <button class="btn btn-primary btn-sm mb-2"
                        @onclick="Toggle">
                    + Skriv kommentar
                </button>
            </div>

            @if (show)
            {
                <div class="border rounded p-3">

                    <textarea class="form-control mb-2"
                              rows="3"
                              @bind="text"
                              placeholder="Skriv din kommentar...">
            </textarea>

                    <button class="btn btn-success btn-sm"
                            @onclick="Submit"
                            disabled="@string.IsNullOrWhiteSpace(text)">
                        Skicka
                    </button>

                </div>
            }

        </div>
    </Authorized>
</AuthorizeView>
@code {
    [Parameter] public int PostId { get; set; }
    [Parameter] public EventCallback OnCommentCreated { get; set; }

    private bool show = false;
    private string text = string.Empty;

    private void Toggle()
    {
        show = !show;
    }

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(text)) return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true) return;

        var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (userId == null)
            return;


        await postService.CreatePostCommentAsync(PostId, text, userId);

        text = string.Empty;
        show = false;

        await OnCommentCreated.InvokeAsync();
    }
}